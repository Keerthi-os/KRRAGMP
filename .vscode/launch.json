{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start kpragfiori",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/krragfiori",
      "runtimeExecutable": "npx",
      "windows": {
        "runtimeExecutable": "npx.cmd"
      },
      "runtimeArgs": [
        "fiori",
        "run"
      ],
      "args": [
        "--open",
        "test/flp.html#app-preview"
      ],
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "outputCapture": "std",
      "env": {
        "DEBUG": "--inspect",
        "FIORI_TOOLS_URL_PARAMS": "sap-ui-xx-viewCache=false",
        "run.config": "{\"handlerId\":\"fiori_tools\",\"runnableId\":\"/home/user/projects/KRRAG/krragfiori\"}"
      }
    },
    {
      "name": "Start krragfiori Local",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/krragfiori",
      "runtimeExecutable": "npx",
      "windows": {
        "runtimeExecutable": "npx.cmd"
      },
      "runtimeArgs": [
        "fiori",
        "run"
      ],
      "args": [
        "--config",
        "./ui5-local.yaml",
        "--open",
        "test/flp.html#app-preview"
      ],
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "outputCapture": "std",
      "env": {
        "FIORI_TOOLS_URL_PARAMS": "sap-ui-xx-viewCache=false",
        "run.config": "{\"handlerId\":\"fiori_tools\",\"runnableId\":\"/home/user/projects/KRRAG/krragfiori\"}"
      }
    },
    {
      "name": "Debug to check performance",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "krmain:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true
    }
  ]
}
 